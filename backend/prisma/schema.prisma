generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  username    String   @unique
  password    String
  name        String
  bio         String?
  avatarUrl   String?
  coverUrl    String?
  userType    UserType @default(FAN)
  sport       String[]
  city        String?
  state       String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts             Post[]
  comments          Comment[]
  likes             Like[]
  followers         Follow[]       @relation("following")
  following         Follow[]       @relation("follower")
  championships     Championship[] @relation("organizer")
  registrations     Registration[]
  notifications     Notification[]
  sentNotifications Notification[] @relation("sender")
  
  teams             TeamMember[]
  captainOf         Team[]
  sentMessages      Message[]      @relation("SentMessages")
  receivedMessages  Message[]      @relation("ReceivedMessages")
  stories           Story[]
  score             Int            @default(0)
  matchesPlayed     Int            @default(0)
  matchesWon        Int            @default(0)
  badges            String[]       @default([])
  
  match1            Match[]        @relation("Player1Matches")
  match2            Match[]        @relation("Player2Matches")
  
  matchParticipations MatchParticipant[]
  
  activities        Activity[]
  
  @@map("users")
}

enum UserType {
  FAN
  ATHLETE
  COACH
  REFEREE
  ORGANIZER
  JOURNALIST
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Post {
  id        String   @id @default(uuid())
  content   String
  imageUrl  String?
  sport     String?
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  authorId  String
  postId    String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId],   references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Championship {
  id                   String             @id @default(uuid())
  title                String
  description          String?
  sport                String
  imageUrl             String?
  organizerId          String
  status               ChampionshipStatus @default(DRAFT)
  format               ChampionshipFormat @default(KNOCKOUT)
  registrationType     RegistrationType   @default(INDIVIDUAL)
  maxParticipants      Int?
  advancePerGroup      Int?               @default(2)
  groupsCount          Int?               @default(0)
  registrationFee      Float              @default(0)
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  location             String
  city                 String
  state                String
  rules                String?
  prizes               String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organizer     User           @relation("organizer", fields: [organizerId], references: [id])
  registrations Registration[]
  results       Result[]
  matches       Match[]
  groups        Group[]

  @@map("championships")
}

model Group {
  id             String       @id @default(uuid())
  name           String       // e.g., "Grupo A"
  championshipId String
  championship   Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  
  matches        Match[]
  
  // Teams in this group (calculated or explicitly linked?)
  // For simplicity, let's link teams or players here if needed, or just rely on matches.
  // Actually, we need to know who is in the group.
  participants   Registration[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("groups")
}

enum ChampionshipStatus {
  DRAFT
  OPEN
  CLOSED
  ONGOING
  FINISHED
  CANCELLED
}

enum ChampionshipFormat {
  KNOCKOUT
  ROUND_ROBIN
  GROUPS_PLUS_KNOCKOUT
}

enum RegistrationType {
  INDIVIDUAL
  TEAM
}

model Registration {
  id             String             @id @default(uuid())
  userId         String
  championshipId String
  status         RegistrationStatus @default(PENDING)
  teamName       String?
  participants   String[]
  createdAt      DateTime           @default(now())

  user         User         @relation(fields: [userId],         references: [id])
  championship Championship @relation(fields: [championshipId], references: [id])
  teamId       String?
  team         Team?        @relation(fields: [teamId],         references: [id])
  
  groupId      String?
  group        Group?       @relation(fields: [groupId],        references: [id])

  @@unique([userId, championshipId])
  @@map("registrations")
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Result {
  id             String   @id @default(uuid())
  championshipId String
  phase          String
  team1          String
  team2          String
  score1         Int
  score2         Int
  date           DateTime
  notes          String?
  createdAt      DateTime @default(now())

  championship Championship @relation(fields: [championshipId], references: [id])

  @@map("results")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  senderId  String?
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())

  user   User  @relation(fields: [userId],  references: [id], onDelete: Cascade)
  sender User? @relation("sender", fields: [senderId], references: [id])

  @@map("notifications")
}

enum NotificationType {
  NEW_FOLLOWER
  POST_LIKE
  POST_COMMENT
  CHAMPIONSHIP_RESULT
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  NEW_CHAMPIONSHIP
  TEAM_INVITE
  PRIVATE_MESSAGE
  MATCH_REMINDER
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  logoUrl     String?
  captainId   String
  captain     User     @relation(fields: [captainId], references: [id])
  sport       String
  members     TeamMember[]
  registrations Registration[]
  messages      Message[]      @relation("TeamMessages")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  match1 Match[] @relation("Team1Matches")
  match2 Match[] @relation("Team2Matches")

  @@map("teams")
}

model TeamMember {
  id       String           @id @default(uuid())
  teamId   String
  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id])
  role     TeamMemberRole   @default(PLAYER)
  status   TeamMemberStatus @default(PENDING)
  joinedAt DateTime         @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

enum TeamMemberStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TeamMemberRole {
  CAPTAIN
  PLAYER
  COACH
}

model Match {
  id             String      @id @default(uuid())
  championshipId String?
  championship   Championship? @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  
  groupId        String?
  group          Group?        @relation(fields: [groupId],        references: [id])

  team1Id        String?
  team1          Team?       @relation("Team1Matches", fields: [team1Id], references: [id])
  team2Id        String?
  team2          Team?       @relation("Team2Matches", fields: [team2Id], references: [id])

  player1Id      String?
  player1        User?       @relation("Player1Matches", fields: [player1Id], references: [id])
  player2Id      String?
  player2        User?       @relation("Player2Matches", fields: [player2Id], references: [id])

  score1         Int         @default(0)
  score2         Int         @default(0)
  
  date           DateTime
  location       String?
  phase          String?      
  round          Int?         @default(1)
  bracketOrder   Int?         // Position in the bracket for visual layout
  nextMatchId    String?      // For knockout brackets
  
  status         MatchStatus @default(SCHEDULED)
  winnerId       String?
  isWalkover     Boolean     @default(false)
  
  isOfficial     Boolean     @default(true)
  isHighlighted  Boolean     @default(false)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  activities     Activity[]
  participants   MatchParticipant[]

  @@map("matches")
}

model MatchParticipant {
  id      String @id @default(uuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  side    Int     // 1 for Team 1 / Player 1 side, 2 for Team 2 / Player 2 side

  @@map("match_participants")
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String?
  receiver   User?    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  teamId     String?
  team       Team?    @relation("TeamMessages", fields: [teamId], references: [id])
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("messages")
}

model Story {
  id        String   @id @default(uuid())
  imageUrl  String
  type      String   @default("PHOTO")
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    String

  user      User     @relation(fields: [userId], references: [id])

  @@map("stories")
}

model Activity {
  id        String   @id @default(uuid())
  type      String   
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id])
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("activities")
}